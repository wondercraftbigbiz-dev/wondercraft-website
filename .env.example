# Wondercraft — environment variables
#
# Copy to .env.local for development (.env.local is gitignored) and set the same
# values in Vercel → Project → Settings → Environment Variables for deploys.
#
# NOTHING here is required for the site to run. With myPOS or Supabase unset,
# the order modal falls back to the "we'll call you" enquiry form and the card
# payment button is hidden. Never commit real values.

# ─── Site ────────────────────────────────────────────────────────────────────
# Absolute public origin, no trailing slash. Used to build the myPOS callback
# URLs and as the canonical metadata base. myPOS requires HTTPS for URL_Notify
# and reverses transactions sent to a non-SSL URL, so http:// is only accepted
# for http://localhost during development.
NEXT_PUBLIC_SITE_URL=https://wondercraft.bg

# ─── Supabase ────────────────────────────────────────────────────────────────
# Project: "Wondercraft Website" (ref ppuxxxhflctkzahnvxje, eu-west-1)
NEXT_PUBLIC_SUPABASE_URL=https://ppuxxxhflctkzahnvxje.supabase.co

# SERVER ONLY — bypasses row level security entirely. Every table has RLS on
# with zero policies and place_order/mark_order_paid are granted to service_role
# alone, so order handling does not work without this. Must never be exposed to
# the browser or prefixed with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ─── myPOS Checkout ──────────────────────────────────────────────────────────
# "test" points at https://www.mypos.eu/vmp/checkout-test and needs myPOS test
# cards. Switch to "production" only once a test payment has gone through.
MYPOS_ENV=test

# From myPOS account → Online payments → your store.
MYPOS_SID=
# Your myPOS client / wallet number.
MYPOS_WALLET_NUMBER=
# Index myPOS assigned to the certificate you uploaded. Usually 1.
MYPOS_KEY_INDEX=1

# RSA keys, 2048-bit. Generate yours with:
#   openssl genrsa -out mypos_private.key 2048
#   openssl req -new -x509 -days 3650 -key mypos_private.key -out mypos_public.crt
# Upload mypos_public.crt to the myPOS store, then download myPOS's own key.
#
# Either variable accepts: a real multi-line PEM, a PEM with literal \n escapes,
# or the base64 of a whole PEM file. MYPOS_API_PUBLIC_KEY also accepts an X.509
# certificate (-----BEGIN CERTIFICATE-----), which is what myPOS hands out.
MYPOS_PRIVATE_KEY=
MYPOS_API_PUBLIC_KEY=
