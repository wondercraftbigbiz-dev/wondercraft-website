# Wondercraft — environment variables
#
# Copy to .env.local for development (.env.local is gitignored) and set the same
# values in Vercel → Project → Settings → Environment Variables for deploys.
#
# NOTHING here is required for the site to run. Econt defaults to offline
# fixtures, and with myPOS or Supabase unset the order modal falls back to the
# "we'll call you" enquiry form with the card button hidden.
#
# Never commit real values.

# ---------------------------------------------------------------------------
# Site
#
# Absolute public origin, no trailing slash. Used to build the myPOS callback
# URLs and as the canonical metadata base. myPOS requires HTTPS for URL_Notify
# and reverses transactions sent to a non-SSL one, so http:// is accepted only
# for http://localhost during development.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://wondercraft.bg

# ---------------------------------------------------------------------------
# Supabase — order and customer storage
#
# Project "Wondercraft Website" (ppuxxxhflctkzahnvxje, eu-west-1).
# Both are SERVER-ONLY. Do NOT prefix either with NEXT_PUBLIC_ — the service
# role key bypasses row level security. Every table has RLS enabled with zero
# policies and place_order/mark_order_paid are granted to service_role alone,
# so order handling does not work without this key.
# ---------------------------------------------------------------------------
SUPABASE_URL=https://ppuxxxhflctkzahnvxje.supabase.co

# Supabase dashboard -> Project Settings -> API -> service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# myPOS Checkout — card payments
#
# "test" points at https://www.mypos.eu/vmp/checkout-test and needs myPOS test
# cards. Switch to "production" only after a test payment has gone through.
# ---------------------------------------------------------------------------
MYPOS_ENV=test

# From the myPOS account -> Online payments -> your store.
MYPOS_SID=
# Your myPOS client / wallet number.
MYPOS_WALLET_NUMBER=
# Index myPOS assigned to the certificate you uploaded. Usually 1.
MYPOS_KEY_INDEX=1

# RSA keys, 2048-bit. Generate yours with:
#   openssl genrsa -out mypos_private.key 2048
#   openssl req -new -x509 -days 3650 -key mypos_private.key -out mypos_public.crt
# Upload mypos_public.crt to the myPOS store, then download myPOS's own key.
#
# Either variable accepts: a real multi-line PEM, a PEM with literal \n escapes,
# or the base64 of a whole PEM file. MYPOS_API_PUBLIC_KEY also accepts an X.509
# certificate (-----BEGIN CERTIFICATE-----), which is what myPOS hands out.
MYPOS_PRIVATE_KEY=
MYPOS_API_PUBLIC_KEY=

# ---------------------------------------------------------------------------
# Econt delivery (e-Econt JSON API)
#
# SERVER-SIDE ONLY. Never prefix any of these with NEXT_PUBLIC_ — that would
# inline the credentials into the browser bundle. Everything that reads them
# lives under lib/econt/ and starts with `import 'server-only'`.
#
# Note: delivery is currently FREE to the customer, so Econt provides the
# destination picker (city / office / address) rather than the price. The
# shipping-price path is kept for internal cost visibility and future label
# creation — see PACKED_PARCEL in lib/data/pricing.ts, still unmeasured.
# ---------------------------------------------------------------------------

# fixture = no network, served from lib/econt/fixtures (the default, so a fresh
#           clone works offline and in sandboxes that block *.econt.com).
# live    = talk to ECONT_BASE_URL for real.
ECONT_MODE=fixture

# Test:       https://demo.econt.com/ee/services
# Production: https://ee.econt.com/services
#
# REQUIRED whenever ECONT_MODE=live — there is no default in live mode, on
# purpose. Credentials set with this left blank would otherwise fall back to
# demo and quote demo tariffs as if they were the contract's, silently.
#
# The two environments have SEPARATE accounts: real contract credentials do not
# work against demo, and the demo pair below does not work against production.
# Note also that demo returns a demo tariff — only production returns the rates
# your contract actually charges, so only production prices are safe to show.
ECONT_BASE_URL=https://demo.econt.com/ee/services

# Econt's public demo credentials. Replace with the real ones (from the Econt
# business contract) via the Vercel environment UI — never in this file.
ECONT_USERNAME=iasp-dev
ECONT_PASSWORD=1Asp-dev

# Force a failure in fixture mode to exercise the UI's error branches:
# timeout | auth | validation | upstream | empty
# ECONT_FIXTURE_FAULT=

# ---------------------------------------------------------------------------
# Sender — us. Becomes the shipment's sender.
#
# Required to PRICE OR CREATE a shipment, but deliberately not to read the
# nomenclature: you need to list offices in order to find your own office code,
# so requiring the code first would be circular. City name must be in Bulgarian
# (Cyrillic) and the phone is passed to Econt verbatim, so no spaces.
#
# Set ECONT_SENDER_OFFICE_CODE (we drop parcels at an office) OR the street
# fields (Econt collects from our address). Office code wins if both are set.
# ---------------------------------------------------------------------------
ECONT_SENDER_NAME=
ECONT_SENDER_PHONE=
ECONT_SENDER_CITY_NAME=
ECONT_SENDER_CITY_POST_CODE=
ECONT_SENDER_OFFICE_CODE=
ECONT_SENDER_STREET=
ECONT_SENDER_STREET_NUM=
ECONT_SENDER_STREET_OTHER=

# ---------------------------------------------------------------------------
# Econt automat (АПС) parcel limits. Defaults live in lib/econt/constraints.ts;
# override here when Econt changes them, without a deploy of new code.
# ---------------------------------------------------------------------------
# ECONT_APS_MAX_WEIGHT_KG=20
# ECONT_APS_MAX_L_CM=60
# ECONT_APS_MAX_W_CM=40
# ECONT_APS_MAX_H_CM=40
